<h2>Edit <%= resource_name.to_s.humanize %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%# Render validation errors for the form %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email %></p>

    <%# Email field (editable account email) %>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <%# Show pending email confirmation status if applicable %>
  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <p>
      <%= f.label :password %>
      <i>(leave blank if you don't want to change it)</i>
    </p>

    <%# New password field (optional) %>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>

    <%# Display minimum password length if defined %>
    <% if @minimum_password_length %>
      <p><em><%= @minimum_password_length %> characters minimum</em></p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation %></p>

    <%# Password confirmation field %>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p>
      <%= f.label :current_password %>
      <i>(we need your current password to confirm your changes)</i>
    </p>

    <%# Current password required to authorize updates %>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

  <div class="actions">
    <%# Submit button to update account details %>
    <%= f.submit "Update" %>
  </div>
<% end %>

<h3>Cancel my account</h3>

<div>
  Unhappy?
  <%# Button to delete the account %>
  <%= button_to "Cancel my account",
      registration_path(resource_name),
      data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" },
      method: :delete %>
</div>

<%# Navigation back link %>
<%= link_to "Back", :back %>