<h2>Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%# Render validation errors for the form %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <%# Hidden token used to validate the password reset request %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <p><%= f.label :password, "New password" %></p>

    <%# Display minimum password length requirement if defined %>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>

    <%# New password input %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "Confirm new password" %></p>

    <%# Password confirmation input %>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%# Submit button to update the password %>
    <%= f.submit "Change my password" %>
  </div>
<% end %>

<%# Render shared Devise navigation links (e.g. sign in, sign up) %>
<%= render "devise/shared/links" %>