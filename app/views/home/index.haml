.container.mt-5
  .row.justify-content-center
    .col-lg-8.text-center
      %h1.display-5.fw-bold.mb-3
        Healthcare Volunteering

      %p.lead.text-muted.mb-4
        Find volunteering opportunities or recruit volunteers in healthcare.

      -# When a volunteer is signed in (but not an organisation)
      - if volunteer_signed_in? && !organisation_signed_in?
        .d-flex.flex-wrap.justify-content-center.gap-2
          = link_to "Browse Organisations", organisations_path, class: "btn btn-primary btn-lg"
          = link_to "Browse Opportunities", opportunities_path, class: "btn btn-primary btn-lg"
          = link_to "Register Organisation", new_organisation_registration_path, class: "btn btn-outline-success btn-lg"

      -# When no user is signed in
      - if !volunteer_signed_in? && !organisation_signed_in?
        .d-flex.flex-wrap.justify-content-center.gap-2
          = link_to "Sign Up as Volunteer", new_volunteer_registration_path, class: "btn btn-outline-primary btn-lg"
          = link_to "Register Organisation", new_organisation_registration_path, class: "btn btn-outline-success btn-lg"

      -# When only an organisation is signed in
      - if organisation_signed_in? && !volunteer_signed_in?
        .d-flex.flex-wrap.justify-content-center.gap-2
          = link_to "Post an Opportunity", new_opportunity_path, class: "btn btn-success btn-lg"
          = link_to "Sign Up as Volunteer", new_volunteer_registration_path, class: "btn btn-outline-primary btn-lg"

      -# When both roles are signed in
      - if volunteer_signed_in? && organisation_signed_in?
        .d-flex.flex-wrap.justify-content-center.gap-2
          = link_to "Browse Organisations", organisations_path, class: "btn btn-primary btn-lg"
          = link_to "Browse Opportunities", opportunities_path, class: "btn btn-primary btn-lg"
          = link_to "Post an Opportunity", new_opportunity_path, class: "btn btn-success btn-lg"